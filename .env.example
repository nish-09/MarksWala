# ============================================================================
# MarksWala environment configuration. Copy to `.env` and fill in real values.
# NEVER commit `.env`. AI keys are read only by the backend/worker, never the browser.
# ============================================================================

APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO

# --- Infrastructure (use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and adds seconds per call) ---
DATABASE_URL=postgresql+psycopg://marks:marks@127.0.0.1:5432/markswala
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=markswala_course_chunks

# --- AI (Gemini is the V1 provider; see backend/app/providers) -------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=                     # https://aistudio.google.com/apikey
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
# GEMINI_EVAL_MODEL=                # optional: a separate model for grading + feedback (defaults to GEMINI_TEXT_MODEL)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=4

# --- Storage ---------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./backend/storage
MAX_RESOURCE_UPLOAD_MB=50
MAX_QUESTION_PAPER_UPLOAD_MB=20
MAX_ANSWER_SHEET_UPLOAD_MB=100
MAX_ANSWER_SHEET_PAGES=60

# --- Sessions / security ---------------------------------------------------
# Production: SECRET_KEY must be 32+ random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=markswala_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false                 # must be true in production (HTTPS)
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000  # comma-separated; also the allowed Origin list for state-changing requests
ALLOW_REGISTRATION=true
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Grading policy defaults (exams can override thresholds) ---------------------
CONFIDENCE_HIGH_THRESHOLD=0.85      # >= this: high confidence
CONFIDENCE_REVIEW_THRESHOLD=0.70    # < this: mandatory review; in between: review recommended
DEFAULT_PASS_PERCENTAGE=40
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# --- Frontend --------------------------------------------------------------
# Server-side URL the Next.js server proxies /api/* to.
BACKEND_URL=http://localhost:8000
